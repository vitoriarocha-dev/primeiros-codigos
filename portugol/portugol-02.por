programa {
  funcao inicio() {
    inteiro N1, N2
    real M
    escreva ("Informe um numero: ")
    leia(N1)
    escreva("Informe outro numero: ")
    leia(N2)
    // Atrbuiçao de valor com o sinal = 
    M = (N1 + N2)/2
    // Exibindo uma mensagem clara com a resposta
    escreva("A media entre ", N1, " e ", N2, " e igual a ", M)
  }
}
